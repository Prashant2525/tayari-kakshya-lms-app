# =============================================================================
# Tayari Kakshya — production stack settings (docker-compose.prod.yml)
# Copy to infra/production/.env ON THE SERVER (git-ignored; chmod 600). Never commit it.
# The API / worker / website settings live in a second file named by TK_APP_ENV_FILE (template: /.env.example).
# Guide: docs/ENVIRONMENT_AND_PRODUCTION_DEPLOYMENT_GUIDE.md §8
# =============================================================================

# The application settings file (absolute path, readable by root only), e.g. /etc/tayari-kakshya/production.env
TK_APP_ENV_FILE=

# Addresses (DNS A/AAAA records → this server). Caddy gets their HTTPS certificates automatically.
WEB_DOMAIN=
API_DOMAIN=
ADMIN_DOMAIN=
# Let's Encrypt account / expiry notices.
ACME_EMAIL=

# Database (the container creates it on first start). DATABASE_URL in the application file must use the same values:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_DB=tayari_kakshya
POSTGRES_USER=tayari_kakshya
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Connections: at least API_REPLICAS × DATABASE_POOL_MAX + worker + 20.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB

# Redis. REDIS_URL in the application file: redis://:<REDIS_PASSWORD>@redis:6379
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# How many API processes run behind the proxy (audit F-11). Start with 2; size it from the staging load test.
API_REPLICAS=2

# CMS build values (public — they end up in the page's JavaScript): Sentry React project DSN, environment label.
VITE_SENTRY_DSN=
VITE_APP_ENV=production

# Set by deploy.sh to the git commit; images are tagged with it (rollback = start an older tag).
TK_RELEASE=

# Backups (backup.sh). Passphrase for the encrypted dumps — keep a copy in your password manager: without it the
# backups cannot be read. Generate: openssl rand -base64 32
BACKUP_PASSPHRASE=
# Where backups are written on this server.
BACKUP_DIR=/var/backups/tayari-kakshya
# Off-site copy (L4): an rclone remote and path, e.g. r2-backups:tayari-kakshya-db. Empty = no off-site copy (not
# acceptable for production).
BACKUP_RCLONE_REMOTE=
