# =============================================================================
# Tayari Kakshya Admin CMS (apps/admin) — PUBLIC build-time settings
# Copy to apps/admin/.env (git-ignored). Vite reads THIS folder's .env, not the root one, and copies every VITE_*
# value into the page's JavaScript: anyone can read them. NEVER put secrets here.
# Values are fixed when the CMS is built (`pnpm --filter @tk/admin build`): rebuild after a change (in development,
# restart `pnpm --filter @tk/admin dev`). Guide: docs/ENVIRONMENT_AND_PRODUCTION_DEPLOYMENT_GUIDE.md
# =============================================================================

# Where the CMS calls the API. Leave EMPTY (recommended): the CMS calls /api on its own address, which the dev server
# (and in production the reverse proxy) forwards to the API — the staff sign-in cookie needs that.
VITE_API_URL=

# Errors from the CMS (Sentry React project DSN — public identifier). Empty = off.
VITE_SENTRY_DSN=
# Labels for Sentry: staging | production, and the release (e.g. the git commit).
VITE_APP_ENV=
VITE_APP_RELEASE=

# Not read from this file: VITE_API_PROXY (development / tests only) is a shell variable that points the dev server's
# /api proxy elsewhere (default http://localhost:4000).
