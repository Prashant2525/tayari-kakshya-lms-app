{
  "name": "@tk/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Tayari Kakshya student app (Expo + Expo Router).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --android --localhost",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/mukta": "0.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "7.11.0",
    "@tanstack/react-query": "5.104.0",
    "@tk/contracts": "workspace:*",
    "@tk/design-tokens": "workspace:*",
    "@tk/domain": "workspace:*",
    "expo": "57.0.26",
    "expo-application": "57.0.3",
    "expo-auth-session": "57.0.13",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-device": "57.0.2",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "lucide-react-native": "1.49.0",
    "posthog-react-native": "4.78.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-webview": "13.16.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tk/config": "workspace:*",
    "@tk/e2e-support": "workspace:*",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.13",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
