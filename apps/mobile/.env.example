# =============================================================================
# Tayari Kakshya student app (apps/mobile) — PUBLIC build-time settings
# Copy to apps/mobile/.env (git-ignored) for local development. Expo reads THIS folder's .env, not the root one.
# For store builds the same names are set as EAS environment variables (expo.dev → project → Environment variables,
# or `eas env:set --environment production ...`); eas.json picks the environment per build profile.
#
# Every EXPO_PUBLIC_* value is copied into the app's code and can be read by anyone who has the app.
# NEVER put a password, API secret, private key, payment key, database address or Bunny key here.
# After changing a value: restart `pnpm --filter @tk/mobile dev` (clear the cache with --clear if it seems stale);
# store builds need a new build. Guide: docs/ENVIRONMENT_AND_PRODUCTION_DEPLOYMENT_GUIDE.md
# =============================================================================

# The API's public https origin, e.g. https://api.<your-domain>. REQUIRED for production builds (the build fails
# without it). Leave EMPTY in development: the app then uses the API on the computer running Expo (port 4000).
EXPO_PUBLIC_API_URL=

# Google sign-in OAuth client ids (public identifiers, not secrets). The Google button is hidden while the id for the
# platform is empty. Must match GOOGLE_OAUTH_*_CLIENT_ID in the API's environment.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Crash reports (Sentry React Native project DSN — a public identifier). Empty = off.
EXPO_PUBLIC_SENTRY_DSN=
# Labels release builds in Sentry and PostHog: staging | production (development builds report "development").
EXPO_PUBLIC_APP_ENV=

# Product analytics (PostHog project API key — public by design). Empty = analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=

# --- Build-time only (read by app.config.ts, not embedded as EXPO_PUBLIC_) -------------------------------------
# Store identifiers (D-065). Empty = com.tayarikakshya.app. Changing them after publishing creates a NEW app listing.
APP_ANDROID_PACKAGE=
APP_IOS_BUNDLE_ID=
# Another EAS project (optional; app.config.ts has the owner's project id).
EAS_PROJECT_ID=
# Path to Firebase's google-services.json (Android push through FCM). For store builds upload it as an EAS *file*
# environment variable named GOOGLE_SERVICES_JSON. Empty = no Android push in that build.
GOOGLE_SERVICES_JSON=

# --- Set as EAS *secret* environment variables, NEVER in this file ---------------------------------------------
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT — upload source maps during release builds.
