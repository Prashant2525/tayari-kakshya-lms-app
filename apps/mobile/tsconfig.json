{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "app.config.ts",
    "playwright.config.ts",
    "vitest.config.mts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
