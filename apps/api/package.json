{
  "name": "@tk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tayari Kakshya backend API and worker (NestJS on Fastify).",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist dist/main.js\"",
    "dev:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "11.1.0",
    "@tk/contracts": "workspace:*",
    "@tk/design-tokens": "workspace:*",
    "@tk/domain": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "google-auth-library": "11.1.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@tk/config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "concurrently": "10.0.5",
    "dotenv": "18.0.5",
    "eslint": "10.11.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
