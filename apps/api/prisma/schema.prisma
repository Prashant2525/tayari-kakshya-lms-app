// Tayari Kakshya — PostgreSQL schema. See docs/DATABASE_ARCHITECTURE.md.
// Conventions: UUIDv7 ids, snake_case tables/columns, timestamptz, soft delete only where documented.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Extensions (citext, pg_trgm) are created in the first migration's SQL.
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserKind {
  student
  staff
}

enum UserStatus {
  active
  suspended
  pending_deletion
  deleted
}

enum Locale {
  en
  ne
}

enum Platform {
  android
  ios
  web
}

model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  kind                UserKind
  status              UserStatus @default(active)
  /// Null after account erasure (D-032).
  email               String?    @unique @db.Citext
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  /// Only verified phone numbers are stored here (E.164).
  phone               String?    @unique
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  /// Null for Google-only accounts that never set a password.
  passwordHash        String?    @map("password_hash")
  fullName            String     @map("full_name")
  locale              Locale     @default(en)
  /// When the student last opened the Notice tab (for its "new" badge).
  noticesSeenAt       DateTime?  @map("notices_seen_at") @db.Timestamptz(6)
  dob                 DateTime?  @db.Date
  gender              String?
  educationLevelId    String?    @map("education_level_id") @db.Uuid
  deviceLimitOverride Int?       @map("device_limit_override")
  /// TOTP secret (AES-256-GCM encrypted). Set during setup; active once mfaEnabledAt is set (staff only).
  mfaSecretEnc        String?    @map("mfa_secret_enc")
  mfaEnabledAt        DateTime?  @map("mfa_enabled_at") @db.Timestamptz(6)
  /// Last accepted TOTP time step — prevents replaying a code within its validity window.
  mfaLastUsedStep     Int?       @map("mfa_last_used_step")
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  educationLevel      EducationLevel?          @relation(fields: [educationLevelId], references: [id], onDelete: SetNull)
  identities          AuthIdentity[]
  sessions            AuthSession[]
  otpCodes            OtpCode[]
  deletionRequests    AccountDeletionRequest[]
  roles               UserRole[]
  staffScopes         StaffScope[]
  recoveryCodes       MfaRecoveryCode[]
  instructorProfile   InstructorProfile?
  courseInstructor    CourseInstructor[]
  entitlements        Entitlement[]            @relation("EntitlementUser")
  grantedEntitlements Entitlement[]            @relation("EntitlementGrantedBy")
  orders              Order[]
  refundsRequested    Refund[]                 @relation("RefundRequester")
  notifications       Notification[]
  deliveries          NotificationDelivery[]
  pushTokens          PushToken[]
  notificationPrefs   NotificationPreference?
  courseUpdatesSent   CourseUpdate[]
  liveClassesTaught   LiveClass[]              @relation("LiveInstructor")
  liveClassesCreated  LiveClass[]              @relation("LiveCreator")
  liveAttendance      LiveAttendance[]
  courseInterests     CourseInterest[]         @relation("InterestedStudent")
  interestsContacted  CourseInterest[]         @relation("InterestContactedBy")
  accountEmails       AccountEmail[]
  referralCode        ReferralCode?
  referralsMade       Referral[]               @relation("Referrer")
  referredBy          Referral?                @relation("Referee")
  ownedCoupons        Coupon[]                 @relation("CouponOwner")
  refundsDecided      Refund[]                 @relation("RefundDecider")
  refundsCompleted    Refund[]                 @relation("RefundCompleter")
  questionReports     QuestionReport[]         @relation("QuestionReportUser")
  resolvedReports     QuestionReport[]         @relation("QuestionReportResolver")
  questionImports     QuestionImport[]         @relation("QuestionImportCreator")
  uploadedMedia       MediaAsset[]
  targetPosts         UserTargetPost[]
  learningProgress    LearningProgress[]
  bookmarks           Bookmark[]
  attempts            Attempt[]
  streak              UserStreak?
  gradedAnswers       AttemptAnswer[]          @relation("AttemptAnswerGrader")
  certificates        Certificate[]
  mistakes            Mistake[]
  practiceAnswers     PracticeAnswer[]
  studyTime           StudyTime[]
  studyClock          StudyClock?
  studyPlans          StudyPlan[]
  reviews             CourseReview[]
  moderatedReviews    CourseReview[]           @relation("ReviewModerator")
  discussionPosts     DiscussionPost[]
  hiddenPosts         DiscussionPost[]         @relation("PostHider")
  discussionReports   DiscussionReport[]
  discussionBan       DiscussionBan?           @relation("BannedUser")
  discussionBansGiven DiscussionBan[]          @relation("BanGiver")
  revokedCertificates Certificate[]            @relation("CertificateRevoker")

  @@index([kind, status])
  @@map("users")
}

model AuthIdentity {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

enum AuthAudience {
  student
  staff
}

model AuthSession {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  audience     AuthAudience
  deviceId     String       @map("device_id")
  deviceName   String       @map("device_name")
  platform     Platform
  ip           String?
  userAgent    String?      @map("user_agent")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?      @map("revoke_reason")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Every refresh token ever issued for a session. Presenting an already-used token = theft → session revoked.
model AuthRefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

enum OtpPurpose {
  verify_email
  verify_phone
  reset_password
}

enum OtpChannel {
  email
  phone
}

model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  purpose    OtpPurpose
  channel    OtpChannel
  /// Email or E.164 phone the code was sent to.
  target     String
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model AccountDeletionRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([userId])
  @@map("account_deletion_requests")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model EducationLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// LocalizedText { en?, ne? }
  name      Json
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("education_levels")
}

// ───────────────────────────── Access control ─────────────────────────────

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  /// The protected Super Admin role (D-036): all permissions, cannot be edited or deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

enum StaffScopeType {
  course
  subject
}

/// Restricts a staff member (e.g. instructor) to specific courses/subjects.
model StaffScope {
  userId    String         @map("user_id") @db.Uuid
  scopeType StaffScopeType @map("scope_type")
  scopeId   String         @map("scope_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scopeType, scopeId])
  @@map("staff_scopes")
}

// ───────────────────────────── Operations ─────────────────────────────

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

/// Append-only. The production DB role has no UPDATE/DELETE on this table.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @map("actor_type")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  changes     Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ───────────────────────────── Media ─────────────────────────────

enum MediaKind {
  image
  pdf
}

enum MediaVisibility {
  public
  private
}

/// Files in object storage (R2 / SeaweedFS in development). Bytes never live in the database.
model MediaAsset {
  id           String          @id @default(uuid(7)) @db.Uuid
  kind         MediaKind
  visibility   MediaVisibility
  objectKey    String          @unique @map("object_key")
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  sha256       String
  width        Int?
  height       Int?
  pageCount    Int?            @map("page_count")
  /// Image renditions: { "w320": "key", "w640": "key", ... }
  variants     Json?
  /// LocalizedText alt text for images.
  altText      Json?           @map("alt_text")
  uploadedById String?         @map("uploaded_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  examNodeIcons    ExamNode[]
  subjectIcons     Subject[]
  courseThumbnails Course[]
  pdfItems         LearningItem[]
  instructorPhotos InstructorProfile[]
  articleCovers    Article[]
  bannerImages     Banner[]

  @@index([kind, createdAt(sort: Desc)])
  @@index([sha256])
  @@map("media_assets")
}

// ───────────────────────────── Publishing ─────────────────────────────

enum PublishStatus {
  draft
  in_review
  scheduled
  published
  archived
}

enum AccessLevel {
  free
  premium
}

// ───────────────────────────── Exam taxonomy (D-007, D-010) ─────────────────────────────

/// Admin-managed category types (audit §4.1): authority, level, service, group, sub-group, post, exam stage…
/// A node's type must rank lower in the hierarchy (higher `rank`) than its parent's.
model ExamNodeType {
  /// Stable identifier used by APIs and imports; never changes.
  key           String   @id @db.VarChar(40)
  name          Json
  description   Json?
  rank          Int
  /// Top-level types have no parent; every other type needs one.
  topLevel      Boolean  @default(false) @map("top_level")
  /// Papers can be linked to nodes of this type (posts, exam stages).
  canHavePapers Boolean  @default(false) @map("can_have_papers")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  nodes ExamNode[]

  @@map("exam_node_types")
}

model ExamNode {
  id          String        @id @default(uuid(7)) @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  nodeType    String        @map("node_type") @db.VarChar(40)
  /// LocalizedText
  name        Json
  slug        String
  description Json?
  iconMediaId String?       @map("icon_media_id") @db.Uuid
  sortOrder   Int           @default(0) @map("sort_order")
  status      PublishStatus @default(draft)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  type            ExamNodeType     @relation(fields: [nodeType], references: [key], onDelete: Restrict)
  parent          ExamNode?        @relation("ExamNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        ExamNode[]       @relation("ExamNodeTree")
  icon            MediaAsset?      @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)
  papers          PostPaper[]
  courses         CourseExamNode[]
  questionSources QuestionSource[]

  assessments Assessment[]
  targetedBy  UserTargetPost[]

  @@index([parentId, sortOrder])
  @@index([nodeType])
  @@map("exam_nodes")
}

model Paper {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            Json
  code            String?
  fullMarks       Decimal?      @map("full_marks") @db.Decimal(6, 2)
  passMarks       Decimal?      @map("pass_marks") @db.Decimal(6, 2)
  durationMinutes Int?          @map("duration_minutes")
  pattern         Json?
  status          PublishStatus @default(draft)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  posts           PostPaper[]
  courseSubjects  CourseSubject[]
  questionSources QuestionSource[]

  @@map("papers")
}

model PostPaper {
  examNodeId String @map("exam_node_id") @db.Uuid
  paperId    String @map("paper_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  examNode ExamNode @relation(fields: [examNodeId], references: [id], onDelete: Cascade)
  paper    Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@id([examNodeId, paperId])
  @@map("post_papers")
}

// ───────────────────────────── Content tree ─────────────────────────────

model Subject {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        Json
  summary     Json?
  iconMediaId String?       @map("icon_media_id") @db.Uuid
  status      PublishStatus @default(draft)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  icon      MediaAsset?     @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)
  chapters  Chapter[]
  courses   CourseSubject[]
  questions Question[]

  assessments Assessment[]

  @@map("subjects")
}

model Chapter {
  id               String        @id @default(uuid(7)) @db.Uuid
  subjectId        String        @map("subject_id") @db.Uuid
  numberLabel      String?       @map("number_label")
  title            Json
  description      Json?
  estimatedMinutes Int?          @map("estimated_minutes")
  sortOrder        Int           @default(0) @map("sort_order")
  status           PublishStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topics  Topic[]

  assessments Assessment[]

  @@index([subjectId, sortOrder])
  @@map("chapters")
}

model Topic {
  id               String        @id @default(uuid(7)) @db.Uuid
  chapterId        String        @map("chapter_id") @db.Uuid
  numberLabel      String?       @map("number_label")
  title            Json
  description      Json?
  estimatedMinutes Int?          @map("estimated_minutes")
  sortOrder        Int           @default(0) @map("sort_order")
  status           PublishStatus @default(draft)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  items     LearningItem[]
  questions Question[]

  assessments Assessment[]

  @@index([chapterId, sortOrder])
  @@map("topics")
}

enum LearningItemType {
  note
  pdf
  video
}

enum ContentLanguage {
  en
  ne
  both
}

model LearningItem {
  id              String           @id @default(uuid(7)) @db.Uuid
  topicId         String           @map("topic_id") @db.Uuid
  type            LearningItemType
  title           Json
  accessLevel     AccessLevel      @default(premium) @map("access_level")
  language        ContentLanguage  @default(both)
  sortOrder       Int              @default(0) @map("sort_order")
  status          PublishStatus    @default(draft)
  publishAt       DateTime?        @map("publish_at") @db.Timestamptz(6)
  /// type=note: { en?: TipTapDoc, ne?: TipTapDoc }
  noteContent     Json?            @map("note_content")
  /// type=pdf
  pdfMediaId      String?          @map("pdf_media_id") @db.Uuid
  downloadable    Boolean          @default(false)
  /// type=video
  videoAssetId    String?          @map("video_asset_id") @db.Uuid
  durationSeconds Int?             @map("duration_seconds")
  createdById     String?          @map("created_by") @db.Uuid
  updatedById     String?          @map("updated_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  topic Topic       @relation(fields: [topicId], references: [id], onDelete: Restrict)
  pdf   MediaAsset? @relation(fields: [pdfMediaId], references: [id], onDelete: Restrict)
  video VideoAsset? @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)

  progress LearningProgress[]

  @@index([topicId, sortOrder])
  @@index([status, publishAt])
  @@map("learning_items")
}

enum VideoProvider {
  bunny
  youtube
}

enum VideoStatus {
  uploading
  processing
  ready
  failed
}

model VideoAsset {
  id              String        @id @default(uuid(7)) @db.Uuid
  provider        VideoProvider
  providerVideoId String        @map("provider_video_id")
  status          VideoStatus   @default(ready)
  title           String?
  durationSeconds Int?          @map("duration_seconds")
  thumbnailUrl    String?       @map("thumbnail_url")
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          LearningItem[]
  liveRecordings LiveClass[]

  @@unique([provider, providerVideoId])
  @@map("video_assets")
}

// ───────────────────────────── Catalog ─────────────────────────────

enum ValidityType {
  days
  fixed_date
  lifetime
}

model Course {
  id                    String          @id @default(uuid(7)) @db.Uuid
  slug                  String
  title                 Json
  shortDescription      Json?           @map("short_description")
  description           Json?
  thumbnailMediaId      String?         @map("thumbnail_media_id") @db.Uuid
  language              ContentLanguage @default(both)
  /// Paisa (NPR x 100). 0 = free course. Set by admins (D-023).
  pricePaisa            Int             @default(0) @map("price_paisa")
  salePricePaisa        Int?            @map("sale_price_paisa")
  saleStartsAt          DateTime?       @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt            DateTime?       @map("sale_ends_at") @db.Timestamptz(6)
  validityType          ValidityType    @default(lifetime) @map("validity_type")
  validityDays          Int?            @map("validity_days")
  validityEndsOn        DateTime?       @map("validity_ends_on") @db.Date
  isFeatured            Boolean         @default(false) @map("is_featured")
  popularityRank        Int?            @map("popularity_rank")
  /// Certificate for finishing this course (D-049); none when null.
  certificateTemplateId String?         @map("certificate_template_id") @db.Uuid
  status                PublishStatus   @default(draft)
  publishAt             DateTime?       @map("publish_at") @db.Timestamptz(6)
  createdById           String?         @map("created_by") @db.Uuid
  updatedById           String?         @map("updated_by") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(6)

  thumbnail           MediaAsset?          @relation(fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: Restrict)
  certificates        Certificate[]
  examNodes           CourseExamNode[]
  subjects            CourseSubject[]
  instructors         CourseInstructor[]
  entitlements        Entitlement[]
  orderItems          OrderItem[]
  couponTargets       CouponTarget[]
  plans               PlanCourse[]

  assessments Assessment[]
  progress    LearningProgress[]
  updates     CourseUpdate[]
  liveClasses LiveClass[]
  interests   CourseInterest[]
  studyPlans  StudyPlan[]
  reviews     CourseReview[]

  @@index([status, isFeatured, popularityRank])
  @@index([certificateTemplateId])
  @@map("courses")
}

model CourseExamNode {
  courseId   String @map("course_id") @db.Uuid
  examNodeId String @map("exam_node_id") @db.Uuid

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examNode ExamNode @relation(fields: [examNodeId], references: [id], onDelete: Cascade)

  @@id([courseId, examNodeId])
  @@index([examNodeId])
  @@map("course_exam_nodes")
}

/// Onboarding (S1): categories a student is preparing for, in the order they chose them.
model UserTargetPost {
  userId     String   @map("user_id") @db.Uuid
  examNodeId String   @map("exam_node_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examNode ExamNode @relation(fields: [examNodeId], references: [id], onDelete: Cascade)

  @@id([userId, examNodeId])
  @@index([examNodeId])
  @@map("user_target_posts")
}

/// Where a student is in a learning item (video seconds / PDF page) and whether it is finished. Items are shared
/// between courses, so progress belongs to the item; `courseId` only remembers where it was opened (Continue).
model LearningProgress {
  userId         String    @map("user_id") @db.Uuid
  learningItemId String    @map("learning_item_id") @db.Uuid
  courseId       String?   @map("course_id") @db.Uuid
  position       Int?
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@id([userId, learningItemId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([learningItemId])
  @@map("learning_progress")
}

enum BookmarkTarget {
  learning_item
  question
}

/// A lesson or practice question the student saved for later. The target is checked when listed (it may have been
/// unpublished since), so there is no foreign key to two tables; rows go when the user is erased.
model Bookmark {
  userId     String         @map("user_id") @db.Uuid
  targetType BookmarkTarget @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model CourseSubject {
  courseId               String   @map("course_id") @db.Uuid
  subjectId              String   @map("subject_id") @db.Uuid
  paperId                String?  @map("paper_id") @db.Uuid
  sortOrder              Int      @default(0) @map("sort_order")
  displayFullMarks       Decimal? @map("display_full_marks") @db.Decimal(6, 2)
  displayPassMarks       Decimal? @map("display_pass_marks") @db.Decimal(6, 2)
  displayDurationMinutes Int?     @map("display_duration_minutes")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  paper   Paper?  @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@id([courseId, subjectId])
  @@index([subjectId])
  @@map("course_subjects")
}

model CourseInstructor {
  courseId  String @map("course_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@map("course_instructors")
}

/// Public profile of a staff member shown to students (D-013).
model InstructorProfile {
  userId       String   @id @map("user_id") @db.Uuid
  displayName  Json     @map("display_name")
  bio          Json?
  photoMediaId String?  @map("photo_media_id") @db.Uuid
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo MediaAsset? @relation(fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@map("instructor_profiles")
}

// ───────────────────────────── Entitlements ─────────────────────────────

enum EntitlementScope {
  course
  plan
}

enum EntitlementSource {
  order
  admin_grant
  coupon
  referral
  /// Self-service enrolment in a course priced at 0 (L6).
  free_enrol
}

enum EntitlementStatus {
  active
  revoked
  expired
}

/// Access rights. Created only by server-side flows (verified payments in Phase 11, admin grants now). Never deleted.
model Entitlement {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  scopeType     EntitlementScope  @map("scope_type")
  courseId      String?           @map("course_id") @db.Uuid
  /// scopeType=plan: the plan bought (its courses are read when access is checked, D-054).
  planId        String?           @map("plan_id") @db.Uuid
  sourceType    EntitlementSource @map("source_type")
  sourceId      String?           @map("source_id")
  startsAt      DateTime          @default(now()) @map("starts_at") @db.Timestamptz(6)
  /// Null = lifetime.
  endsAt        DateTime?         @map("ends_at") @db.Timestamptz(6)
  status        EntitlementStatus @default(active)
  grantedById   String?           @map("granted_by") @db.Uuid
  note          String?
  revokedAt     DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?           @map("revoked_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User    @relation("EntitlementUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User?   @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  plan      Plan?   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([courseId])
  @@map("entitlements")
}

// ───────────── Question bank (D-016, D-020) ─────────────

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  fill_blank
  match
  numeric
  subjective
}

enum Difficulty {
  easy
  medium
  hard
}

/// Passage / comprehension shared by several questions.
model QuestionGroup {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       Json?
  /// { en?: TipTapDoc, ne?: TipTapDoc }
  passage     Json
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  questions Question[]

  @@map("question_groups")
}

/// Metadata lives here; the stem, choices and answer key live in immutable versions (every edit = new version).
model Question {
  id                   String          @id @default(uuid(7)) @db.Uuid
  type                 QuestionType
  subjectId            String          @map("subject_id") @db.Uuid
  topicId              String?         @map("topic_id") @db.Uuid
  groupId              String?         @map("group_id") @db.Uuid
  difficulty           Difficulty
  defaultMarks         Decimal         @map("default_marks") @db.Decimal(6, 2)
  defaultNegativeMarks Decimal         @default(0) @map("default_negative_marks") @db.Decimal(6, 2)
  language             ContentLanguage @default(both)
  accessLevel          AccessLevel     @default(premium) @map("access_level")
  isPyq                Boolean         @default(false) @map("is_pyq")
  status               PublishStatus   @default(draft)
  currentVersionId     String?         @unique @map("current_version_id") @db.Uuid
  /// Plain text of the stem (both languages) for search.
  searchText           String          @default("") @map("search_text")
  createdById          String?         @map("created_by") @db.Uuid
  updatedById          String?         @map("updated_by") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?       @map("deleted_at") @db.Timestamptz(6)

  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic          Topic?            @relation(fields: [topicId], references: [id], onDelete: Restrict)
  group          QuestionGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  currentVersion QuestionVersion?  @relation("QuestionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       QuestionVersion[] @relation("QuestionVersions")
  sources        QuestionSource[]
  tags           QuestionTag[]
  reports        QuestionReport[]

  assessmentLinks AssessmentQuestion[]
  attemptAnswers  AttemptAnswer[]
  mistakes        Mistake[]
  practiceAnswers PracticeAnswer[]

  @@index([subjectId, topicId, type, difficulty, status])
  @@index([groupId])
  @@map("questions")
}

/// Immutable (a trigger forbids UPDATE/DELETE): attempts keep pointing at exactly what the student saw.
model QuestionVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  versionNo   Int      @map("version_no")
  /// QuestionContent from @tk/contracts: stem, options, answer key, model answer, explanation.
  content     Json
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question       Question        @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Restrict)
  currentOf      Question?       @relation("QuestionCurrentVersion")
  attemptAnswers AttemptAnswer[]

  @@unique([questionId, versionNo])
  @@map("question_versions")
}

/// Previous-year-question metadata (D-020).
model QuestionSource {
  id         String  @id @default(uuid(7)) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  examNodeId String? @map("exam_node_id") @db.Uuid
  paperId    String? @map("paper_id") @db.Uuid
  yearBs     Int?    @map("year_bs")
  note       String?

  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examNode ExamNode? @relation(fields: [examNodeId], references: [id], onDelete: Restrict)
  paper    Paper?    @relation(fields: [paperId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([examNodeId, yearBs])
  @@map("question_sources")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  questions QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String @map("question_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

enum QuestionReportReason {
  wrong_answer
  typo
  unclear
  outdated
  other
}

enum QuestionReportStatus {
  open
  resolved
  rejected
}

model QuestionReport {
  id             String               @id @default(uuid(7)) @db.Uuid
  questionId     String               @map("question_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  reason         QuestionReportReason
  message        String?
  status         QuestionReportStatus @default(open)
  resolvedById   String?              @map("resolved_by") @db.Uuid
  resolutionNote String?              @map("resolution_note")
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  user       User     @relation("QuestionReportUser", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("QuestionReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_reports")
}

enum QuestionImportStatus {
  previewed
  committed
  expired
}

/// Excel question import (D-046): the checked rows wait here between preview and confirm.
model QuestionImport {
  id           String               @id @default(uuid(7)) @db.Uuid
  fileName     String               @map("file_name")
  status       QuestionImportStatus @default(previewed)
  /// { rows, valid, invalid, warnings }
  summary      Json
  /// Resolved, validated rows ready to insert (QuestionInput + passage refs); cleared after commit.
  payload      Json?
  createdById  String               @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  committedAt  DateTime?            @map("committed_at") @db.Timestamptz(6)
  createdCount Int?                 @map("created_count")

  createdBy User @relation("QuestionImportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@map("question_imports")
}

// ───────────── Assessments (D-021, D-022, D-044) ─────────────

enum AssessmentType {
  quiz
  subject_test
  weekly
  mock
  pyq_mock
  daily_challenge
}

enum AssessmentAvailability {
  always
  window
}

enum ResultRelease {
  immediate
  after_close
  manual
}

enum PremiumAccessRule {
  linked
  any_course
  plans_only
}

enum LateStartRule {
  until_close
  full_duration
}

enum CountedAttemptRule {
  first
  best
  latest
}

enum AttemptStatus {
  in_progress
  pending_grading
  completed
  voided
}

enum AnswerOutcome {
  correct
  partial
  wrong
  skipped
  pending
}

enum SubjectiveGrading {
  none
  self
  instructor
}

enum SectionPickMode {
  fixed
  random
}

/// Rules are chosen per assessment in the CMS; nothing here is a business default (D-021, D-044).
model Assessment {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  type               AssessmentType
  title              Json
  instructions       Json?
  courseId           String?                @map("course_id") @db.Uuid
  subjectId          String?                @map("subject_id") @db.Uuid
  chapterId          String?                @map("chapter_id") @db.Uuid
  topicId            String?                @map("topic_id") @db.Uuid
  examNodeId         String?                @map("exam_node_id") @db.Uuid
  accessLevel        AccessLevel            @default(premium) @map("access_level")
  availability       AssessmentAvailability
  opensAt            DateTime?              @map("opens_at") @db.Timestamptz(6)
  closesAt           DateTime?              @map("closes_at") @db.Timestamptz(6)
  durationSeconds    Int?                   @map("duration_seconds")
  maxAttempts        Int?                   @map("max_attempts")
  passMarks          Decimal?               @map("pass_marks") @db.Decimal(8, 2)
  /// ScoringRulesInput: negativeMarking, multipleChoice, match, fillBlank, scoreFloor.
  scoring            Json
  shuffleQuestions   Boolean                @map("shuffle_questions")
  shuffleOptions     Boolean                @map("shuffle_options")
  resultRelease      ResultRelease          @map("result_release")
  resultsReleasedAt  DateTime?              @map("results_released_at") @db.Timestamptz(6)
  showExplanations   Boolean                @map("show_explanations")
  leaderboardEnabled Boolean                @map("leaderboard_enabled")
  subjectiveGrading  SubjectiveGrading      @map("subjective_grading")
  /// D-048: who may take it when Premium, how a late start is timed, which attempt is the official result.
  premiumAccess      PremiumAccessRule      @default(linked) @map("premium_access")
  lateStart          LateStartRule          @default(until_close) @map("late_start")
  countedAttempt     CountedAttemptRule     @default(first) @map("counted_attempt")
  challengeDate      DateTime?              @map("challenge_date") @db.Date
  status             PublishStatus          @default(draft)
  publishAt          DateTime?              @map("publish_at") @db.Timestamptz(6)
  createdById        String?                @map("created_by") @db.Uuid
  updatedById        String?                @map("updated_by") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(6)

  course    Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subject   Subject?             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter   Chapter?             @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  topic     Topic?               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  examNode  ExamNode?            @relation(fields: [examNodeId], references: [id], onDelete: Restrict)
  sections  AssessmentSection[]
  questions AssessmentQuestion[]
  attempts  Attempt[]
  reminders AssessmentReminder[]
  articles  Article[]

  @@index([type, status])
  @@index([courseId])
  @@index([subjectId])
  @@map("assessments")
}

model AssessmentSection {
  id                       String          @id @default(uuid(7)) @db.Uuid
  assessmentId             String          @map("assessment_id") @db.Uuid
  title                    Json?
  sortOrder                Int             @map("sort_order")
  pickMode                 SectionPickMode @map("pick_mode")
  /// random: QuestionPoolFilter
  filter                   Json?
  questionCount            Int?            @map("question_count")
  marksPerQuestion         Decimal?        @map("marks_per_question") @db.Decimal(6, 2)
  negativeMarksPerQuestion Decimal?        @map("negative_marks_per_question") @db.Decimal(6, 2)

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@index([assessmentId, sortOrder])
  @@map("assessment_sections")
}

model AssessmentQuestion {
  id            String   @id @default(uuid(7)) @db.Uuid
  assessmentId  String   @map("assessment_id") @db.Uuid
  sectionId     String   @map("section_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  sortOrder     Int      @map("sort_order")
  marks         Decimal? @db.Decimal(6, 2)
  negativeMarks Decimal? @map("negative_marks") @db.Decimal(6, 2)

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section    AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionId])
  @@index([sectionId, sortOrder])
  @@index([questionId])
  @@map("assessment_questions")
}

/// A student's attempt at an assessment (§10). The plan pins question versions, marks and option order at start, so
/// later edits never change an attempt. Scores are centimarks.
model Attempt {
  id               String        @id @default(uuid(7)) @db.Uuid
  assessmentId     String        @map("assessment_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  attemptNo        Int           @map("attempt_no")
  status           AttemptStatus @default(in_progress)
  autoSubmitted    Boolean       @default(false) @map("auto_submitted")
  /// A past daily challenge taken as practice (D-049): never counts for streaks or rankings.
  practice         Boolean       @default(false)
  /// When this attempt's wrong / partly correct answers were added to the mistake notebook (D-050): only once it is
  /// completed and its results are released, so the notebook never reveals unreleased results.
  mistakesSyncedAt DateTime?     @map("mistakes_synced_at") @db.Timestamptz(6)
  /// When the student was told (or saw on submitting) that this attempt's result is out (D-060): once per attempt.
  resultNotifiedAt DateTime?     @map("result_notified_at") @db.Timestamptz(6)
  startedAt        DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  deadlineAt       DateTime?     @map("deadline_at") @db.Timestamptz(6)
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz(6)
  /// AttemptPlan: sections → questions (question id, version id, marks, negative marks, option order).
  plan             Json
  maxScore         Int           @map("max_score")
  score            Int?
  correctCount     Int           @default(0) @map("correct_count")
  partialCount     Int           @default(0) @map("partial_count")
  wrongCount       Int           @default(0) @map("wrong_count")
  skippedCount     Int           @default(0) @map("skipped_count")
  pendingCount     Int           @default(0) @map("pending_count")
  passed           Boolean?
  timeTakenSeconds Int?          @map("time_taken_seconds")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@unique([assessmentId, userId, attemptNo])
  @@index([userId, startedAt(sort: Desc)])
  @@index([assessmentId, status])
  @@index([status, deadlineAt])
  @@index([assessmentId, practice, status], map: "attempts_ranking_idx")
  @@map("attempts")
}

/// One row per planned question, created at start; `response` is the latest autosaved answer.
model AttemptAnswer {
  attemptId         String         @map("attempt_id") @db.Uuid
  questionId        String         @map("question_id") @db.Uuid
  questionVersionId String         @map("question_version_id") @db.Uuid
  response          Json?
  markedForReview   Boolean        @default(false) @map("marked_for_review")
  answeredAt        DateTime?      @map("answered_at") @db.Timestamptz(6)
  outcome           AnswerOutcome?
  /// Centimarks awarded (negative with negative marking).
  awarded           Int?
  gradedById        String?        @map("graded_by") @db.Uuid
  gradedAt          DateTime?      @map("graded_at") @db.Timestamptz(6)
  graderComment     String?        @map("grader_comment")
  /// When the app made the save that set this answer (out-of-order saves are ignored; null for older apps).
  clientSavedAt     DateTime?      @map("client_saved_at") @db.Timestamptz(6)

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  gradedBy        User?           @relation("AttemptAnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@id([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

/// Daily-challenge streak (D-049): consecutive Nepal calendar days with that day's challenge submitted.
model UserStreak {
  userId      String   @id @map("user_id") @db.Uuid
  currentDays Int      @default(0) @map("current_days")
  longestDays Int      @default(0) @map("longest_days")
  /// The last Nepal calendar day that counted.
  lastDay     DateTime @map("last_day") @db.Date
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

enum CertificateLanguage {
  en
  ne
}

/// Wording and rule of a course-completion certificate (D-049, D-050), shared by any number of courses.
model CertificateTemplate {
  id              String              @id @default(uuid(7)) @db.Uuid
  /// Name for staff in the CMS.
  name            String
  language        CertificateLanguage @default(en)
  /// Share of the course's lessons a student must finish, in percent (1–100).
  requiredPercent Int                 @map("required_percent")
  /// LocalizedText: heading, line before the name, line between name and course, issuer.
  title           Json
  intro           Json?
  statement       Json
  issuerName      Json                @map("issuer_name")
  /// [{ name: LocalizedText, role: LocalizedText }], at most 3.
  signatories     Json                @default("[]")
  /// No new certificates are issued from an inactive template; issued ones stay valid.
  active          Boolean             @default(true)
  createdById     String?             @map("created_by") @db.Uuid
  updatedById     String?             @map("updated_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses      Course[]
  certificates Certificate[]

  @@map("certificate_templates")
}

/// An issued certificate. `content` is a snapshot of what was printed, so later template or name edits do not
/// change it. Verified publicly by `code`.
model Certificate {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// 12 characters (Crockford base32), stored without dashes.
  code         String    @unique
  userId       String    @map("user_id") @db.Uuid
  courseId     String    @map("course_id") @db.Uuid
  templateId   String    @map("template_id") @db.Uuid
  /// { holderName, courseTitle, title, intro, statement, issuerName, signatories, language }
  content      Json
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedById  String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  template  CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  revokedBy User?               @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId, issuedAt(sort: Desc)])
  @@index([templateId])
  @@map("certificates")
}

enum MistakeStatus {
  active
  mastered
  removed
}

enum MistakeSource {
  test
  practice
}

/// The mistake notebook (D-050): one row per student and question, kept after it is mastered or removed so a new
/// mistake brings it back with its history.
model Mistake {
  userId         String        @map("user_id") @db.Uuid
  questionId     String        @map("question_id") @db.Uuid
  status         MistakeStatus @default(active)
  timesWrong     Int           @default(1) @map("times_wrong")
  /// Correct answers in revision in a row; mastered at the CMS setting `mistakes.revision.correctInARow`.
  correctStreak  Int           @default(0) @map("correct_streak")
  lastSource     MistakeSource @map("last_source")
  lastWrongAt    DateTime      @map("last_wrong_at") @db.Timestamptz(6)
  lastReviewedAt DateTime?     @map("last_reviewed_at") @db.Timestamptz(6)
  masteredAt     DateTime?     @map("mastered_at") @db.Timestamptz(6)
  /// The answer and explanation may be shown even without access to the subject: the student already saw them in
  /// the released solutions of a test they took.
  answerVisible  Boolean       @default(false) @map("answer_visible")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, status, lastWrongAt(sort: Desc)])
  @@index([questionId])
  @@map("mistakes")
}

// ───────────── Progress analytics (Phase 13a, S8, D-066) ─────────────

enum PracticeAnswerSource {
  practice
  revision
}

/// An auto-marked practice or revision answer, scored on the server (T-047), kept for accuracy and weak / strong
/// topics (T-064). Written answers are self-reviewed and never recorded. Erased with the account.
model PracticeAnswer {
  id         String               @id @default(uuid(7)) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  questionId String               @map("question_id") @db.Uuid
  source     PracticeAnswerSource
  /// correct / partial / wrong only (CHECK).
  outcome    AnswerOutcome
  answeredAt DateTime             @default(now()) @map("answered_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([questionId])
  @@map("practice_answers")
}

enum StudyActivity {
  video
  reading
  practice
  test
}

/// Seconds of active study per student, Nepal calendar day and activity (D-066, T-064).
model StudyTime {
  userId    String        @map("user_id") @db.Uuid
  day       DateTime      @db.Date
  activity  StudyActivity
  seconds   Int           @default(0)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, activity])
  @@map("study_time")
}

/// When the student's app last reported study time: a report is never credited more than the time since then.
model StudyClock {
  userId       String   @id @map("user_id") @db.Uuid
  lastReportAt DateTime @map("last_report_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_clocks")
}

/// A student's study plan for one course (S7, D-066, T-065): the plan itself is worked out when asked for, from the
/// student's unfinished lessons and tests, so falling behind re-plans from today. One plan per student and course.
model StudyPlan {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  /// The exam day (AD; shown in BS).
  examDate      DateTime @map("exam_date") @db.Date
  minutesPerDay Int      @map("minutes_per_day")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("study_plans")
}

enum ReviewStatus {
  pending
  approved
  rejected
}

/// A student's review of a course (S4, D-066, T-066): one per student and course; shown only once staff approve it.
/// Changing it sends it back for approval. Erased with the account.
model CourseReview {
  id              String       @id @default(uuid(7)) @db.Uuid
  courseId        String       @map("course_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  /// 1–5 stars (CHECK).
  rating          Int          @db.SmallInt
  body            String?
  status          ReviewStatus @default(pending)
  rejectionReason String?      @map("rejection_reason")
  moderatedById   String?      @map("moderated_by") @db.Uuid
  moderatedAt     DateTime?    @map("moderated_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?  @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([courseId, userId])
  @@index([courseId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("course_reviews")
}

// ───────────── Discussions / doubts (Phase 13d, S12, D-066) ─────────────

enum DiscussionTarget {
  question
  lesson
}

enum DiscussionPostStatus {
  visible
  hidden
  deleted
}

/// A post under a question or a lesson (T-067): a top-level doubt, or a reply to one (one level). The target is
/// checked when read (it may be unpublished since), like bookmarks, so there is no foreign key to two tables.
model DiscussionPost {
  id           String               @id @default(uuid(7)) @db.Uuid
  targetType   DiscussionTarget     @map("target_type")
  targetId     String               @map("target_id") @db.Uuid
  parentId     String?              @map("parent_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  body         String
  status       DiscussionPostStatus @default(visible)
  /// The best answer to its doubt, marked by staff (replies only; at most one per doubt).
  isBest       Boolean              @default(false) @map("is_best")
  hiddenReason String?              @map("hidden_reason")
  hiddenById   String?              @map("hidden_by") @db.Uuid
  hiddenAt     DateTime?            @map("hidden_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   DiscussionPost?    @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DiscussionPost[]   @relation("Replies")
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenBy User?              @relation("PostHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  reports  DiscussionReport[]

  @@index([targetType, targetId, createdAt])
  @@index([parentId, createdAt])
  @@index([status, createdAt])
  @@index([userId])
  @@map("discussion_posts")
}

enum DiscussionReportReason {
  spam
  rude
  wrong
  other
}

/// A student's report of a post; one per student and post. Open until staff act on the post or dismiss it.
model DiscussionReport {
  id        String                 @id @default(uuid(7)) @db.Uuid
  postId    String                 @map("post_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  reason    DiscussionReportReason
  message   String?
  open      Boolean                @default(true)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([open, createdAt])
  @@map("discussion_reports")
}

/// A student stopped from posting by staff, until a time or with no end (`until` null).
model DiscussionBan {
  userId      String    @id @map("user_id") @db.Uuid
  until       DateTime? @db.Timestamptz(6)
  reason      String
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BanGiver", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("discussion_bans")
}

// ───────────── Commerce (Phase 11, D-003, D-023, D-027, D-051, D-052) ─────────────

enum OrderStatus {
  /// Created; can be paid until `expires_at`.
  pending
  paid
  /// Paid, then refunded in full (D-057): the access it gave was removed.
  refunded
  /// Not paid in time (a payment confirmed later still completes it).
  expired
  cancelled
}

enum OrderChannel {
  android
  ios
  web
}

enum PaymentProvider {
  esewa
  khalti
  connectips
}

enum PaymentStatus {
  /// Handed to the gateway; the student has not come back yet.
  initiated
  /// The gateway has not settled it yet (checked again later).
  pending
  completed
  failed
  cancelled
  expired
}

/// A purchase. Amounts are fixed by the server when the order is created and never come from the client.
/// Financial record: never deleted.
model Order {
  id            String       @id @default(uuid(7)) @db.Uuid
  /// Shown to students and staff, e.g. #000123.
  orderNo       Int          @unique @default(autoincrement()) @map("order_no")
  userId        String       @map("user_id") @db.Uuid
  status        OrderStatus  @default(pending)
  channel       OrderChannel
  currency      String       @default("NPR")
  subtotalPaisa Int          @map("subtotal_paisa")
  discountPaisa Int          @default(0) @map("discount_paisa")
  totalPaisa    Int          @map("total_paisa")
  /// The coupon used (D-025) and its code as typed — kept even if the coupon changes later.
  couponId      String?      @map("coupon_id") @db.Uuid
  couponCode    String?      @map("coupon_code")
  /// VAT that applied (D-055): null rate = not VAT-registered. Inclusive: the total contains `tax_paisa`;
  /// otherwise `tax_paisa` was added on top.
  taxRateBps    Int?         @map("tax_rate_bps")
  taxInclusive  Boolean?     @map("tax_inclusive")
  taxPaisa      Int          @default(0) @map("tax_paisa")
  /// D-058: the friend's referral discount was applied to this order (instead of a coupon — never both, D-059).
  referralId    String?      @map("referral_id") @db.Uuid
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  paidAt        DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: Restrict)
  referral Referral?   @relation("ReferralOrders", fields: [referralId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?
  refunds  Refund[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([couponId, status])
  @@map("orders")
}

/// What was bought, as it was when bought.
model OrderItem {
  id               String  @id @default(uuid(7)) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  /// course | plan
  itemType         String  @map("item_type")
  courseId         String? @map("course_id") @db.Uuid
  planId           String? @map("plan_id") @db.Uuid
  titleSnapshot    Json    @map("title_snapshot")
  unitPricePaisa   Int     @map("unit_price_paisa")
  /// { type, days, endsOn } — the course validity when bought.
  validitySnapshot Json    @map("validity_snapshot")

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([courseId])
  @@index([planId])
  @@map("order_items")
}

/// One attempt to pay an order through a gateway. Success is only ever recorded after the server has verified it
/// with the gateway. Financial record: never deleted.
model Payment {
  id                    String          @id @default(uuid(7)) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(initiated)
  amountPaisa           Int             @map("amount_paisa")
  /// The gateway's id for this payment (Khalti pidx; for eSewa our transaction_uuid = this payment's id).
  providerReference     String?         @map("provider_reference")
  /// The gateway's transaction id once paid (eSewa transaction_code, Khalti transaction_id).
  providerTransactionId String?         @map("provider_transaction_id")
  /// Where the student returns afterwards: an allow-listed address (older rows: "app" / "web").
  returnTo              String          @map("return_to")
  /// The API address the gateway sends the student back to, fixed when the payment starts (null = the configured
  /// PAYMENT_CALLBACK_BASE_URL). In development it is the address the device reached the API on (emulator, phone).
  callbackBase          String?         @map("callback_base")
  /// Set when a second payment completed an order that was already paid (needs a refund decision).
  duplicate             Boolean         @default(false)
  failureReason         String?         @map("failure_reason")
  initiatedAt           DateTime        @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt           DateTime?       @map("completed_at") @db.Timestamptz(6)
  lastCheckedAt         DateTime?       @map("last_checked_at") @db.Timestamptz(6)
  checkCount            Int             @default(0) @map("check_count")
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([status, initiatedAt])
  @@map("payments")
}

/// Everything a gateway told us (redirects, verifications, reconciliation), secrets stripped. Never deleted.
model PaymentEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  paymentId  String?         @map("payment_id") @db.Uuid
  provider   PaymentProvider
  /// redirect | verify | reconcile | initiate
  eventType  String          @map("event_type")
  payload    Json
  /// What it changed: completed, failed, unchanged, rejected (bad signature / amount), duplicate…
  result     String
  receivedAt DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

enum PlanCoverage {
  /// Every course (including courses added later).
  all_courses
  /// The courses linked to the plan (its current list, D-054).
  selected
}

/// A subscription plan (D-023, D-054): bought like a course; while active it gives access to the courses it contains
/// now. Price 0 = shown for comparison only (not sold).
model Plan {
  id             String        @id @default(uuid(7)) @db.Uuid
  slug           String
  name           Json
  description    Json?
  /// LocalizedText[] shown as a check-list on the plan card.
  features       Json          @default("[]")
  pricePaisa     Int           @default(0) @map("price_paisa")
  salePricePaisa Int?          @map("sale_price_paisa")
  saleStartsAt   DateTime?     @map("sale_starts_at") @db.Timestamptz(6)
  saleEndsAt     DateTime?     @map("sale_ends_at") @db.Timestamptz(6)
  validityType   ValidityType  @default(days) @map("validity_type")
  validityDays   Int?          @map("validity_days")
  validityEndsOn DateTime?     @map("validity_ends_on") @db.Date
  coverage       PlanCoverage  @default(selected)
  isFeatured     Boolean       @default(false) @map("is_featured")
  sortOrder      Int           @default(0) @map("sort_order")
  status         PublishStatus @default(draft)
  publishAt      DateTime?     @map("publish_at") @db.Timestamptz(6)
  createdById    String?       @map("created_by") @db.Uuid
  updatedById    String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  courses       PlanCourse[]
  entitlements  Entitlement[]
  orderItems    OrderItem[]
  couponTargets CouponTarget[]

  @@index([status, sortOrder])
  @@map("plans")
}

model PlanCourse {
  planId    String @map("plan_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([planId, courseId])
  @@index([courseId])
  @@map("plan_courses")
}

enum CouponDiscountType {
  percent
  fixed
}

enum CouponAppliesTo {
  everything
  all_courses
  all_plans
  selected
}

/// Coupon codes (D-025, D-054, D-056). Never deleted (orders point at them); staff switch them off instead.
/// Uses are the orders that carry the coupon: paid ones, and unpaid ones while they can still be paid.
model Coupon {
  id               String             @id @default(uuid(7)) @db.Uuid
  /// Upper-case letters, numbers and dashes.
  code             String             @unique
  note             String?
  discountType     CouponDiscountType @map("discount_type")
  percentBps       Int?               @map("percent_bps")
  amountPaisa      Int?               @map("amount_paisa")
  maxDiscountPaisa Int?               @map("max_discount_paisa")
  minOrderPaisa    Int?               @map("min_order_paisa")
  startsAt         DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?          @map("ends_at") @db.Timestamptz(6)
  maxRedemptions   Int?               @map("max_redemptions")
  perUserLimit     Int?               @map("per_user_limit")
  appliesTo        CouponAppliesTo    @map("applies_to")
  /// D-054: off = the coupon does not work while a sale price applies.
  allowOnSale      Boolean            @default(false) @map("allow_on_sale")
  active           Boolean            @default(true)
  /// Set for a referral reward (D-058): only this student can use the code.
  ownerUserId      String?            @map("owner_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  targets   CouponTarget[]
  orders    Order[]
  owner     User?          @relation("CouponOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  rewardFor Referral?      @relation("ReferralReward")

  @@index([ownerUserId])
  @@map("coupons")
}

/// The courses and plans a "selected" coupon works for (exactly one of the two per row).
model CouponTarget {
  id       String  @id @default(uuid(7)) @db.Uuid
  couponId String  @map("coupon_id") @db.Uuid
  courseId String? @map("course_id") @db.Uuid
  planId   String? @map("plan_id") @db.Uuid

  coupon Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, courseId])
  @@unique([couponId, planId])
  @@index([courseId])
  @@index([planId])
  @@map("coupon_targets")
}

enum InvoiceKind {
  /// Not VAT-registered when issued.
  receipt
  /// VAT-registered when issued (heading "Tax Invoice").
  tax_invoice
}

enum InvoiceEmailStatus {
  pending
  sent
  /// The student has no email address.
  skipped
  failed
}

/// One receipt per paid order (D-026, D-057), numbered once and never changed or deleted: everything printed on it is a
/// snapshot taken when it was issued, so the PDF is the same every time it is made.
model Invoice {
  id             String             @id @default(uuid(7)) @db.Uuid
  invoiceNo      String             @unique @map("invoice_no")
  /// Nepali fiscal year, e.g. 2083/84 (null when numbering does not restart each year).
  fiscalYear     String?            @map("fiscal_year")
  sequence       Int
  orderId        String             @unique @map("order_id") @db.Uuid
  kind           InvoiceKind
  buyerName      String             @map("buyer_name")
  buyerContact   String?            @map("buyer_contact")
  /// { businessName, panNumber, address } from the CMS when issued.
  seller         Json
  /// [{ title, unitPricePaisa, validity }]
  items          Json
  subtotalPaisa  Int                @map("subtotal_paisa")
  discountPaisa  Int                @map("discount_paisa")
  couponCode     String?            @map("coupon_code")
  taxRateBps     Int?               @map("tax_rate_bps")
  taxInclusive   Boolean?           @map("tax_inclusive")
  taxPaisa       Int                @map("tax_paisa")
  totalPaisa     Int                @map("total_paisa")
  /// eSewa / Khalti, or null when nothing was paid (D-056).
  paidWith       String?            @map("paid_with")
  issuedAt       DateTime           @map("issued_at") @db.Timestamptz(6)
  emailStatus    InvoiceEmailStatus @default(pending) @map("email_status")
  emailAttempts  Int                @default(0) @map("email_attempts")
  emailAttemptAt DateTime?          @map("email_attempt_at") @db.Timestamptz(6)
  emailedAt      DateTime?          @map("emailed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([fiscalYear, sequence])
  @@index([emailStatus, emailAttemptAt])
  @@map("invoices")
}

/// The next receipt number per fiscal year (`key` = the fiscal year, or "all" when numbering never restarts).
model InvoiceCounter {
  key       String @id
  nextValue Int    @map("next_value")

  @@map("invoice_counters")
}

enum RefundStatus {
  requested
  approved
  rejected
  /// The money was sent back.
  refunded
}

/// Refunds (D-026, D-057): staff ask, someone with `refunds:approve` decides, and whoever sends the money back records
/// its reference. Never deleted.
model Refund {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  amountPaisa       Int          @map("amount_paisa")
  reason            String
  status            RefundStatus @default(requested)
  /// Set when approved: this refund completes the order's total, so the access it gave was removed.
  full              Boolean      @default(false)
  requestedById     String       @map("requested_by") @db.Uuid
  requestedAt       DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedById       String?      @map("decided_by") @db.Uuid
  decidedAt         DateTime?    @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?      @map("decision_note")
  refundedById      String?      @map("refunded_by") @db.Uuid
  refundedAt        DateTime?    @map("refunded_at") @db.Timestamptz(6)
  providerReference String?      @map("provider_reference")
  refundNote        String?      @map("refund_note")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("RefundDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  refundedBy  User? @relation("RefundCompleter", fields: [refundedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, requestedAt])
  @@map("refunds")
}

/// A student's personal referral code (D-058), made the first time they open "Invite friends".
model ReferralCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

enum ReferralStatus {
  /// The friend signed up with the code; their first purchase gets the discount.
  joined
  /// The friend's first purchase was paid; the referrer got the reward coupon.
  rewarded
  /// That purchase was refunded in full: an unused reward was switched off.
  cancelled
}

/// Who referred whom (D-058). One per friend; set only when the friend's account is created (D-059). Never deleted.
model Referral {
  id             String         @id @default(uuid(7)) @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  refereeId      String         @unique @map("referee_id") @db.Uuid
  code           String
  status         ReferralStatus @default(joined)
  firstOrderId   String?        @unique @map("first_order_id") @db.Uuid
  rewardCouponId String?        @unique @map("reward_coupon_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rewardedAt     DateTime?      @map("rewarded_at") @db.Timestamptz(6)
  cancelledAt    DateTime?      @map("cancelled_at") @db.Timestamptz(6)

  referrer     User    @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referee      User    @relation("Referee", fields: [refereeId], references: [id], onDelete: Restrict)
  rewardCoupon Coupon? @relation("ReferralReward", fields: [rewardCouponId], references: [id], onDelete: Restrict)
  orders       Order[] @relation("ReferralOrders")

  @@index([referrerId, createdAt(sort: Desc)])
  @@map("referrals")
}

enum NoticeKind {
  official
  announcement
  instructor
}

/// Notices (D-019, D-060): written and published in the CMS, shown in the app's Notice tab to their audience (for now
/// everyone). When `notify` is set, going live also pushes and emails students (their preferences apply).
model Notice {
  id          String        @id @default(uuid(7)) @db.Uuid
  kind        NoticeKind
  title       Json
  body        Json
  /// {"type":"all"} — kept as data so narrower audiences can be added without a migration.
  audience    Json          @default("{\"type\":\"all\"}")
  isPinned    Boolean       @default(false) @map("is_pinned")
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  notify      Boolean       @default(false)
  status      PublishStatus @default(draft)
  publishAt   DateTime?     @map("publish_at") @db.Timestamptz(6)
  /// Set when push / email deliveries were queued (once).
  notifiedAt  DateTime?     @map("notified_at") @db.Timestamptz(6)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@index([status, publishAt])
  @@map("notices")
}

enum NotificationCategory {
  notice
  course_update
  exam_reminder
  result
  purchase
  article
  discussion
  live_class
}

/// A student's in-app notification (D-033). `sourceKey` makes each event land once per student.
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  title     Json
  body      Json
  /// Where tapping it leads, e.g. {"type":"order","id":"…"}.
  link      Json?
  sourceKey String               @map("source_key")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum DeliveryChannel {
  push
  email
}

enum DeliveryStatus {
  pending
  sent
  failed
  /// Nothing to send to (no device registered, no email address).
  skipped
}

/// Push and email waiting to go out, sent by the worker and retried; one per student, channel and event.
model NotificationDelivery {
  id            String               @id @default(uuid(7)) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  channel       DeliveryChannel
  category      NotificationCategory
  title         Json
  body          Json
  link          Json?
  sourceKey     String               @map("source_key")
  status        DeliveryStatus       @default(pending)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime?            @map("sent_at") @db.Timestamptz(6)
  error         String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, channel, sourceKey])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Expo push tokens of the student's devices; switched off when Expo says the device is gone.
model PushToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  token         String    @unique
  platform      String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("push_tokens")
}

/// What a student chose to hear about by push / email (D-033); missing = everything on.
model NotificationPreference {
  userId    String   @id @map("user_id") @db.Uuid
  prefs     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
}

/// A reminder sent before a test opens (D-060): one per test, reminder time and opening time — a test moved to a new
/// time is reminded again.
model AssessmentReminder {
  id            String   @id @default(uuid(7)) @db.Uuid
  assessmentId  String   @map("assessment_id") @db.Uuid
  minutesBefore Int      @map("minutes_before")
  opensAt       DateTime @map("opens_at") @db.Timestamptz(6)
  /// False when it was due together with a later one (only the nearest is sent).
  sent          Boolean
  recipients    Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, minutesBefore, opensAt])
  @@map("assessment_reminders")
}

/// A course update staff sent to the course's students (D-060). Kept as a record; never deleted.
model CourseUpdate {
  id         String   @id @default(uuid(7)) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      Json
  message    Json
  recipients Int
  sentById   String   @map("sent_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sentBy User   @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@index([courseId, createdAt(sort: Desc)])
  @@map("course_updates")
}

/// D-061: a student on an Apple device opened a paid course they cannot buy in the app (no button: recorded when the
/// course page loads). Staff can email them the website link (App Review 3.1.3). Erased with the account.
model CourseInterest {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  courseId      String    @map("course_id") @db.Uuid
  /// From the student's signed-in session, e.g. "iPhone 15".
  deviceName    String    @map("device_name")
  /// Visits, counted at most once per 30 minutes.
  views         Int       @default(1)
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  contactedAt   DateTime? @map("contacted_at") @db.Timestamptz(6)
  contactedById String?   @map("contacted_by") @db.Uuid

  user        User   @relation("InterestedStudent", fields: [userId], references: [id], onDelete: Cascade)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  contactedBy User?  @relation("InterestContactedBy", fields: [contactedById], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([lastSeenAt(sort: Desc)])
  @@map("course_interests")
}

enum AccountEmailStatus {
  pending
  sent
  skipped
  failed
}

/// Account emails the worker sends once per student (D-061: the welcome email), retried a few times.
model AccountEmail {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  kind      String
  status    AccountEmailStatus @default(pending)
  attempts  Int                @default(0)
  attemptAt DateTime?          @map("attempt_at") @db.Timestamptz(6)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status, attemptAt])
  @@map("account_emails")
}

enum ArticleKind {
  current_affairs
  gorkhapatra
  news
  blog
}

enum ArticlePeriod {
  daily
  weekly
  monthly
  yearly
}

/// Categories for each kind of article (e.g. current affairs: national, international, economy), set in the CMS.
model ArticleCategory {
  id        String      @id @default(uuid(7)) @db.Uuid
  kind      ArticleKind
  name      Json
  sortOrder Int         @default(0) @map("sort_order")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles Article[]

  @@index([kind, sortOrder])
  @@map("article_categories")
}

/// Articles (§12, D-018, D-063): free for everyone, in the app and on the public website.
model Article {
  id               String         @id @default(uuid(7)) @db.Uuid
  kind             ArticleKind
  /// The website address /articles/<slug>.
  slug             String         @unique
  title            Json
  summary          Json?
  body             Json
  coverMediaId     String?        @map("cover_media_id") @db.Uuid
  categoryId       String?        @map("category_id") @db.Uuid
  /// Current affairs only.
  period           ArticlePeriod?
  /// The day (or start of the week / month / year) covered, or the Gorkhapatra issue date.
  periodDate       DateTime?      @map("period_date") @db.Date
  sourceName       String?        @map("source_name")
  sourceUrl        String?        @map("source_url")
  quizAssessmentId String?        @map("quiz_assessment_id") @db.Uuid
  isFeatured       Boolean        @default(false) @map("is_featured")
  notify           Boolean        @default(false)
  /// Set when push / email deliveries were queued (once).
  notifiedAt       DateTime?      @map("notified_at") @db.Timestamptz(6)
  status           PublishStatus  @default(draft)
  publishAt        DateTime?      @map("publish_at") @db.Timestamptz(6)
  createdById      String?        @map("created_by") @db.Uuid
  updatedById      String?        @map("updated_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)

  cover    MediaAsset?      @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quiz     Assessment?      @relation(fields: [quizAssessmentId], references: [id], onDelete: SetNull)

  @@index([kind, status, publishAt])
  @@index([categoryId])
  @@map("articles")
}

enum StaticPageSlug {
  about
  terms
  privacy
  refund
}

/// The working copy of a static page (D-038): staff edit it; readers see the last published version.
model StaticPage {
  slug        StaticPageSlug @id
  title       Json
  body        Json
  updatedById String?        @map("updated_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions StaticPageVersion[]

  @@map("static_pages")
}

/// Every published version of a page, kept as it was (a legal record; cannot be changed or deleted).
model StaticPageVersion {
  id            String         @id @default(uuid(7)) @db.Uuid
  slug          StaticPageSlug
  version       Int
  title         Json
  body          Json
  publishedAt   DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedById String         @map("published_by") @db.Uuid

  page StaticPage @relation(fields: [slug], references: [slug], onDelete: Restrict)

  @@unique([slug, version])
  @@map("static_page_versions")
}

/// Questions and answers in Help & support (D-064).
model Faq {
  id        String   @id @default(uuid(7)) @db.Uuid
  question  Json
  answer    Json
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  /// Not shown in the iPhone app (answers that mention buying, D-027).
  hideOnIos Boolean  @default(false) @map("hide_on_ios")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder])
  @@map("faqs")
}

enum ContactType {
  phone
  whatsapp
  viber
  email
  website
  facebook
  address
}

/// Ways to reach support (D-034), shown in Help & support.
model ContactOption {
  id        String      @id @default(uuid(7)) @db.Uuid
  type      ContactType
  label     Json
  value     String
  note      Json?
  sortOrder Int         @default(0) @map("sort_order")
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sortOrder])
  @@map("contact_options")
}

enum BannerPlacement {
  app
  website
  both
}

enum BannerLinkType {
  none
  course
  plan
  article
  page
  url
}

/// Promotional banners (D-064) on the app's Home and the website's home page.
model Banner {
  id           String          @id @default(uuid(7)) @db.Uuid
  title        Json
  imageMediaId String          @map("image_media_id") @db.Uuid
  linkType     BannerLinkType  @map("link_type")
  linkValue    String          @default("") @map("link_value")
  placement    BannerPlacement
  startsAt     DateTime?       @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?       @map("ends_at") @db.Timestamptz(6)
  sortOrder    Int             @default(0) @map("sort_order")
  active       Boolean         @default(true)
  /// Not shown in the iPhone app (D-027); plan and web links never are.
