# =============================================================================
# Tayari Kakshya LMS — environment template
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# See docs/ENVIRONMENT_REQUIREMENTS.md for what each value is and who provides it.
# Values below are empty placeholders or local-development defaults only.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=4000
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy (Caddy on the VPS) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false
API_BASE_URL=http://localhost:4000
ADMIN_BASE_URL=http://localhost:5173
PUBLIC_WEB_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Database / cache ---------------------------------------------------------
# Local Docker defaults are in infra/docker/docker-compose.dev.yml (dev-only credentials).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tayari_kakshya
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tayari_kakshya_test
DATABASE_DIRECT_URL=
REDIS_URL=redis://localhost:6379

# --- Auth / crypto (generate per environment, e.g. `openssl rand -base64 48`) -
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=
OTP_PEPPER=
ENCRYPTION_KEY=

# --- Google sign-in -----------------------------------------------------------
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
# Not used by the app's sign-in (ID-token flow, no secret needed); keep it only in a secret store.
GOOGLE_OAUTH_WEB_CLIENT_SECRET=

# --- Email --------------------------------------------------------------------
# smtp | log (log = in-memory, development/test only; rejected in staging/production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Tayari Kakshya <no-reply@localhost>"
# Mailpit (local): host localhost, port 1025, UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (only if OTP is approved) --------------------------------------------
# disabled | log (log = in-memory, development/test only). Real provider pending (OPEN_QUESTIONS L1).
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments (sandbox until production credentials are provided) -------------
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_ORDER_TTL_MINUTES=

ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

KHALTI_ENV=sandbox
KHALTI_BASE_URL=
KHALTI_SECRET_KEY=

CONNECTIPS_ENV=sandbox
CONNECTIPS_GATEWAY_URL=
CONNECTIPS_VALIDATE_URL=
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_APP_PASSWORD=
CONNECTIPS_PFX_PATH=
CONNECTIPS_PFX_PASSPHRASE=

# --- Object storage (S3-compatible: Cloudflare R2 in production, SeaweedFS locally) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=tayari-dev-public
S3_BUCKET_PRIVATE=tayari-dev-private
# true for SeaweedFS/MinIO-style endpoints; R2 works with either
S3_FORCE_PATH_STYLE=true
# Production: the R2 public bucket domain or CDN. Development: the API's media proxy.
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/api/v1/public-media
# Development/test only (rejected in staging/production)
PUBLIC_MEDIA_PROXY=true
STORAGE_AUTO_CREATE_BUCKETS=true
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_PDF_MB=100

# --- Video (hybrid: Bunny Stream for premium, YouTube unlisted for free — D-015) ---
VIDEO_PROVIDER=bunny
YOUTUBE_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=
# Signed embed URL lifetime (seconds). Short is safer; the player only needs it to open.
VIDEO_PLAYBACK_TTL_SECONDS=300

# --- Push notifications -------------------------------------------------------
EXPO_ACCESS_TOKEN=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Monitoring / analytics ---------------------------------------------------
# API/worker errors go to Sentry only when SENTRY_DSN_API is set (tests and CI blank it). Check a deployment with
# `pnpm --filter @tk/api cli monitoring-test`. APP_RELEASE (e.g. the git commit) groups errors by release.
SENTRY_DSN_API=
APP_RELEASE=
SENTRY_DSN_ADMIN=
# Source-map upload during release builds (CI / EAS secret); not used at runtime.
SENTRY_AUTH_TOKEN=
# Server-side events (later: website). The app uses EXPO_PUBLIC_POSTHOG_KEY below.
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Mobile (EXPO_PUBLIC_* is embedded in the app binary: never put secrets here)
# For app builds only. Leave empty in development: the app then calls the API (port 4000) on the computer that
# runs the Expo dev server — this PC in the browser, its network address in Expo Go / the emulator.
# Expo reads these from apps/mobile/.env, not this file.
EXPO_PUBLIC_API_URL=
# Google sign-in client ids (public). The Google button is hidden until the id for the platform is set.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Crash reports from the app (Sentry React Native project). EXPO_PUBLIC_APP_ENV names release builds (staging /
# production); development builds report "development".
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=
# Product analytics (public project key; analytics stay off while empty). Host: https://us.i.posthog.com or eu.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# --- Admin CMS (VITE_* is embedded in the page: never put secrets here) ----------
# Vite reads these from apps/admin/.env, not this file.
# Errors from the CMS (Sentry React project); off while empty. VITE_APP_ENV / VITE_APP_RELEASE label builds.
VITE_SENTRY_DSN=
VITE_APP_ENV=
VITE_APP_RELEASE=
