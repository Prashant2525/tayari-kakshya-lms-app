# =============================================================================
# Tayari Kakshya LMS — SERVER-SIDE environment template (repository root)
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# Read by: the API and worker (apps/api), Prisma migrations, the website's server (apps/web), the content importer
# (tools/content-pack) and the test suites. In staging / production these come from the server's environment instead
# of a file. Public values for the app and the CMS live in apps/mobile/.env.example and apps/admin/.env.example — those
# tools do not read this file.
# Step-by-step: docs/ENVIRONMENT_AND_PRODUCTION_DEPLOYMENT_GUIDE.md. Check a configuration (no values printed):
#   pnpm --filter @tk/api cli config-check [--connect] [--env-file <path>]
# Values below are empty placeholders or local-development defaults only.
# =============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=4000
LOG_LEVEL=info
# Which proxies may pass on the visitor's address (X-Forwarded-For): false, or their IP addresses / CIDR ranges,
# comma-separated (the reverse proxy on the VPS and the website's server), e.g. 127.0.0.1,172.18.0.0/16. Anyone else's
# header is ignored. `true` (trust every sender) is refused in staging and production: it lets callers fake their IP
# and dodge per-IP rate limits (Phase 15). The website must sit behind the reverse proxy, which adds the real address.
TRUST_PROXY=false
# Requests per minute per IP on every route (routes keep their own stricter limits too). 300 when unset.
RATE_LIMIT_DEFAULT_PER_MINUTE=300
# How the website's SERVER reaches the API (production: an internal address such as http://api:4000).
API_BASE_URL=http://localhost:4000
# The public website (apps/web, Next.js): coupon share links, canonical addresses, the web payment return page.
# Development: `pnpm --filter @tk/web dev` on port 3000. Production: https://<your domain>.
PUBLIC_WEB_URL=http://localhost:3000
# How students' browsers reach the API (receipt links from the website). Empty = API_BASE_URL.
API_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Database / cache ---------------------------------------------------------
# Local Docker defaults are in infra/docker/docker-compose.dev.yml (dev-only credentials).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tayari_kakshya
# Development / CI only: the API's integration tests (never a production database).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tayari_kakshya_test
# Database connections per process (the API and the worker each keep a pool). Empty = 20. Keep the sum below the
# server's max_connections (PostgreSQL default 100).
DATABASE_POOL_MAX=
REDIS_URL=redis://localhost:6379

# --- Auth / crypto (generate per environment, e.g. `openssl rand -base64 48`) -
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=
OTP_PEPPER=
ENCRYPTION_KEY=

# --- Google sign-in -----------------------------------------------------------
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=

# --- Email --------------------------------------------------------------------
# smtp | log (log = in-memory, development/test only; rejected in staging/production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Tayari Kakshya <no-reply@localhost>"
# Mailpit (local): host localhost, port 1025, UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (only if OTP is approved) --------------------------------------------
# disabled | log (log = in-memory, development/test only). Real provider pending (OPEN_QUESTIONS L1).
SMS_PROVIDER=disabled
# PLANNED (not read by the code yet; names may change when the provider is chosen):
# SMS_API_KEY=
# SMS_SENDER_ID=

# --- Payments (D-003, D-051) -----------------------------------------------------
# Every merchant value lives here: going live is a .env change only (no code change). A gateway is offered when its
# credentials are set (and it is switched on in CMS → Settings → Payment methods). Each gateway's mode picks its
# official endpoints; the *_URL values override them. A production server refuses a sandbox gateway.
# Public https origin of this API that eSewa/Khalti send students back to (production: https://api.<your domain>).
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000
# Where students land afterwards: the app's deep link and the website page (allow-listed).
PAYMENT_RETURN_URL_APP=tayarikakshya://payment-result
PAYMENT_RETURN_URL_WEB=http://localhost:3000/payment-result
# Minutes an unpaid order can be paid (empty = 60).
PAYMENT_ORDER_TTL_MINUTES=

# eSewa ePay v2. Test values are eSewa's published UAT merchant (not secret). Production: ESEWA_ENV=production and
# the merchant's product code + secret key from eSewa.
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# Khalti KPG-2. Test key: test-admin.khalti.com (merchant → keys, "live secret key" of the test account).
# Production: KHALTI_ENV=production and the live secret key from admin.khalti.com.
KHALTI_ENV=sandbox
KHALTI_BASE_URL=
KHALTI_SECRET_KEY=

# ConnectIPS (NCHL, D-076) — all five values or none (the API names a missing one). From NCHL: merchant id, app id,
# app name and app password; the private key of the merchant PFX NCHL issues, as PEM (one line with \n, or the PEM
# file in base64 — guide §5.3 has the exact openssl / base64 commands). CONNECTIPS_ENV picks NCHL's UAT or
# production address; CONNECTIPS_BASE_URL is only an override. Register the success / failure addresses with NCHL
# (guide §5.3). Production refuses CONNECTIPS_ENV=sandbox.
CONNECTIPS_ENV=sandbox
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_APP_PASSWORD=
CONNECTIPS_PRIVATE_KEY=
CONNECTIPS_BASE_URL=

# --- Object storage (S3-compatible: Cloudflare R2 in production, SeaweedFS locally) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=tayari-dev-public
S3_BUCKET_PRIVATE=tayari-dev-private
# true for SeaweedFS/MinIO-style endpoints; R2 works with either
S3_FORCE_PATH_STYLE=true
# Production: the R2 public bucket domain or CDN. Development: the API's media proxy.
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/api/v1/public-media
# Development/test only (rejected in staging/production)
PUBLIC_MEDIA_PROXY=true
STORAGE_AUTO_CREATE_BUCKETS=true
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_PDF_MB=100

# --- Video (hybrid: Bunny Stream for premium, YouTube unlisted for free — D-015) ---
# Optional: fills in YouTube titles / durations (Google Cloud API key restricted to the YouTube Data API v3).
YOUTUBE_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Security → Token authentication key. Required in staging/production when BUNNY_STREAM_LIBRARY_ID is set.
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=
# Signed embed URL lifetime (seconds). Short is safer; the player only needs it to open.
VIDEO_PLAYBACK_TTL_SECONDS=300

# --- Push notifications -------------------------------------------------------
# Expo Push API (T-055). The access token is needed only if "enhanced push security" is on in the Expo account.
# EXPO_PUSH_URL defaults to https://exp.host/--/api/v2/push/send.
EXPO_ACCESS_TOKEN=
# Android (FCM) and iOS (APNs) push credentials are uploaded to Expo (EAS credentials), not set here.

# --- Monitoring / analytics ---------------------------------------------------
# API/worker errors go to Sentry only when SENTRY_DSN_API is set (tests and CI blank it). Check a deployment with
# `pnpm --filter @tk/api cli monitoring-test`. APP_RELEASE (e.g. the git commit) groups errors by release.
SENTRY_DSN_API=
APP_RELEASE=

# --- Content importer (tools/content-pack; only when importing content packs) ------
# CONTENT_API_URL=http://localhost:4000
# CONTENT_ADMIN_EMAIL=
# CONTENT_ADMIN_PASSWORD=
# CONTENT_ADMIN_MFA_CODE=
# 1 = also rewrite questions imported earlier with the pack's current text (new question versions).
# CONTENT_UPDATE_QUESTIONS=
